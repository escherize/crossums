{
  "name": "exact_solve_alternate",
  "description": "Solve a puzzle where no cells are pre-marked as solution - player finds their own",
  "setup": {
    "size": 3,
    "start_board": {
      "size": 3,
      "row_targets": [
        5,
        5,
        5
      ],
      "col_targets": [
        5,
        5,
        5
      ],
      "cells": [
        [
          {
            "value": 5
          },
          {
            "value": 1
          },
          {
            "value": 1
          }
        ],
        [
          {
            "value": 1
          },
          {
            "value": 5
          },
          {
            "value": 1
          }
        ],
        [
          {
            "value": 1
          },
          {
            "value": 1
          },
          {
            "value": 5
          }
        ]
      ]
    }
  },
  "steps": [
    {
      "comment": "All cells are non-solution, so no misstep protection"
    },
    {
      "comment": "The diagonal of 5s is a valid solution"
    },
    {
      "action": "delete_cell",
      "params": {
        "row": 0,
        "col": 1
      }
    },
    {
      "action": "delete_cell",
      "params": {
        "row": 0,
        "col": 2
      }
    },
    {
      "action": "delete_cell",
      "params": {
        "row": 1,
        "col": 0
      }
    },
    {
      "action": "delete_cell",
      "params": {
        "row": 1,
        "col": 2
      }
    },
    {
      "action": "delete_cell",
      "params": {
        "row": 2,
        "col": 0
      }
    },
    {
      "action": "delete_cell",
      "params": {
        "row": 2,
        "col": 1
      }
    },
    {
      "assert": "assert_valid"
    }
  ]
}
