{
  "name": "run_victory",
  "description": "Test completing all stages triggers victory",
  "setup": {
    "action": "start_run"
  },
  "steps": [
    {
      "action": "set_stage",
      "params": {
        "stage": 9,
        "puzzle_index": 2
      }
    },
    {
      "action": "get_run_info",
      "expect_nested": {
        "run.stage": 9,
        "run.puzzle_index": 2
      }
    },
    {
      "action": "complete_puzzle",
      "params": {
        "score": 15000
      },
      "expect": {
        "passed": true
      }
    },
    {
      "action": "get_run_info",
      "expect": {
        "state": "VICTORY"
      }
    }
  ]
}
