{
  "name": "batch_undo_multiple_manual",
  "description": "Multiple manual deletes are separate batches, undo one at a time",
  "setup": {"size": 3, "seed": 12345},
  "steps": [
    {"action": "clear_operators"},
    {"action": "delete_cell", "params": {"row": 0, "col": 0}},
    {"action": "delete_cell", "params": {"row": 0, "col": 1}},
    {"action": "delete_cell", "params": {"row": 0, "col": 2}},
    {"assert": "assert_cell_state", "params": {"row": 0, "col": 0, "state": "deleted"}},
    {"assert": "assert_cell_state", "params": {"row": 0, "col": 1, "state": "deleted"}},
    {"assert": "assert_cell_state", "params": {"row": 0, "col": 2, "state": "deleted"}},
    {"action": "undo"},
    {"assert": "assert_cell_state", "params": {"row": 0, "col": 2, "state": "active"}, "_comment": "Last delete undone"},
    {"assert": "assert_cell_state", "params": {"row": 0, "col": 1, "state": "deleted"}, "_comment": "Still deleted"},
    {"action": "undo"},
    {"assert": "assert_cell_state", "params": {"row": 0, "col": 1, "state": "active"}},
    {"action": "undo"},
    {"assert": "assert_cell_state", "params": {"row": 0, "col": 0, "state": "active"}}
  ]
}
