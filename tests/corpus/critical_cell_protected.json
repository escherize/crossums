{
  "name": "critical_cell_protected",
  "description": "A cell that MUST be kept should be protected - no alternates exist",
  "setup": {
    "size": 3,
    "start_board": {
      "size": 3,
      "row_targets": [
        9,
        5,
        5
      ],
      "col_targets": [
        9,
        5,
        5
      ],
      "cells": [
        [
          {
            "value": 9
          },
          {
            "value": 1
          },
          {
            "value": 1
          }
        ],
        [
          {
            "value": 1
          },
          {
            "value": 5
          },
          {
            "value": 1
          }
        ],
        [
          {
            "value": 1
          },
          {
            "value": 1
          },
          {
            "value": 5
          }
        ]
      ]
    }
  },
  "steps": [
    {
      "comment": "The 9 in (0,0) is the ONLY way to hit row 0 target of 9"
    },
    {
      "comment": "Trying to delete it should fail since no alternate exists"
    },
    {
      "action": "delete_cell",
      "params": {
        "row": 0,
        "col": 0
      },
      "expect_nested": {
        "cell.was_mistake": true,
        "cell.state": "active"
      }
    },
    {
      "comment": "But deleting (0,1) should work - it's not critical"
    },
    {
      "action": "delete_cell",
      "params": {
        "row": 0,
        "col": 1
      },
      "expect_nested": {
        "cell.was_mistake": false,
        "cell.state": "deleted"
      }
    }
  ]
}
