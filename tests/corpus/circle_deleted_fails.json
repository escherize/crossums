{
  "name": "circle_deleted_fails",
  "description": "Test that circling a deleted cell fails and cell stays deleted",
  "setup": {
    "size": 3,
    "start_board": {
      "size": 3,
      "seed": 12345,
      "row_targets": [
        7,
        5,
        5
      ],
      "col_targets": [
        5,
        4,
        8
      ],
      "cells": [
        [
          {
            "value": 1
          },
          {
            "value": 2
          },
          {
            "value": 5
          }
        ],
        [
          {
            "value": 4
          },
          {
            "value": 2
          },
          {
            "value": 3
          }
        ],
        [
          {
            "value": 5
          },
          {
            "value": 6
          },
          {
            "value": 6
          }
        ]
      ]
    }
  },
  "steps": [
    {
      "action": "delete_cell",
      "params": {
        "row": 0,
        "col": 0
      }
    },
    {
      "assert": "assert_cell_state",
      "params": {
        "row": 0,
        "col": 0,
        "state": "deleted"
      }
    },
    {
      "action": "circle_cell",
      "params": {
        "row": 0,
        "col": 0
      },
      "expect_error": "invalid_state"
    },
    {
      "assert": "assert_cell_state",
      "params": {
        "row": 0,
        "col": 0,
        "state": "deleted"
      }
    }
  ]
}
