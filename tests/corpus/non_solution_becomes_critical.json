{
  "name": "non_solution_becomes_critical",
  "description": "A non-solution cell becomes critical when solution cells are deleted",
  "setup": {
    "size": 3,
    "start_board": {
      "size": 3,
      "row_targets": [
        5,
        5,
        5
      ],
      "col_targets": [
        5,
        5,
        5
      ],
      "cells": [
        [
          {
            "value": 5
          },
          {
            "value": 5
          },
          {
            "value": 1
          }
        ],
        [
          {
            "value": 5
          },
          {
            "value": 5
          },
          {
            "value": 1
          }
        ],
        [
          {
            "value": 1
          },
          {
            "value": 1
          },
          {
            "value": 5
          }
        ]
      ]
    }
  },
  "steps": [
    {
      "comment": "Intended solution is diagonal of 5s"
    },
    {
      "comment": "Alternate: anti-diagonal of 5s at (0,1), (1,0)"
    },
    {
      "comment": "Delete (0,0) - the intended solution cell"
    },
    {
      "action": "delete_cell",
      "params": {
        "row": 0,
        "col": 0
      },
      "expect_nested": {
        "cell.was_mistake": false
      }
    },
    {
      "comment": "Now (0,1)=5 is critical for row 0, even though it's NOT marked is_solution"
    },
    {
      "action": "delete_cell",
      "params": {
        "row": 0,
        "col": 1
      },
      "expect_nested": {
        "cell.was_mistake": true,
        "cell.state": "active"
      }
    },
    {
      "comment": "Similarly (1,0)=5 becomes critical for col 0"
    },
    {
      "action": "delete_cell",
      "params": {
        "row": 1,
        "col": 0
      },
      "expect_nested": {
        "cell.was_mistake": true,
        "cell.state": "active"
      }
    },
    {
      "comment": "But (1,1) can be deleted since (1,0) covers row 1 and col 1 has (0,1)"
    },
    {
      "action": "delete_cell",
      "params": {
        "row": 1,
        "col": 1
      },
      "expect_nested": {
        "cell.was_mistake": false
      }
    },
    {
      "comment": "Complete the puzzle"
    },
    {
      "action": "delete_cell",
      "params": {
        "row": 0,
        "col": 2
      }
    },
    {
      "action": "delete_cell",
      "params": {
        "row": 1,
        "col": 2
      }
    },
    {
      "action": "delete_cell",
      "params": {
        "row": 2,
        "col": 0
      }
    },
    {
      "action": "delete_cell",
      "params": {
        "row": 2,
        "col": 1
      }
    },
    {
      "assert": "assert_valid"
    }
  ]
}
