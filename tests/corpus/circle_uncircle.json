{
  "name": "circle_uncircle",
  "description": "Test that uncircling a circled cell returns it to active state",
  "setup": {
    "size": 3,
    "start_board": {
      "size": 3,
      "seed": 12345,
      "row_targets": [7, 5, 5],
      "col_targets": [5, 4, 8],
      "cells": [
        [{"value": 1, "is_solution": false}, {"value": 2, "is_solution": true}, {"value": 5, "is_solution": true}],
        [{"value": 4, "is_solution": false}, {"value": 2, "is_solution": true}, {"value": 3, "is_solution": true}],
        [{"value": 5, "is_solution": true}, {"value": 6, "is_solution": false}, {"value": 6, "is_solution": false}]
      ]
    }
  },
  "steps": [
    {
      "action": "circle_cell",
      "params": {"row": 0, "col": 1}
    },
    {
      "assert": "assert_cell_state",
      "params": {"row": 0, "col": 1, "state": "circled"}
    },
    {
      "action": "uncircle_cell",
      "params": {"row": 0, "col": 1}
    },
    {
      "assert": "assert_cell_state",
      "params": {"row": 0, "col": 1, "state": "active"}
    }
  ]
}
