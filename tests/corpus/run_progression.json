{
  "name": "run_progression",
  "description": "Test stage/puzzle advancement when completing puzzles",
  "setup": {
    "action": "start_run"
  },
  "steps": [
    {
      "assert": "assert_no_targets_satisfied"
    },
    {
      "action": "get_run_info",
      "expect_nested": {
        "run.stage": 1,
        "run.puzzle_index": 0
      }
    },
    {
      "action": "complete_puzzle",
      "params": {
        "score": 500
      },
      "expect": {
        "passed": true
      }
    },
    {
      "action": "get_run_info",
      "expect": {
        "state": "PUZZLE_RESULT"
      }
    },
    {
      "action": "continue_result"
    },
    {
      "action": "get_run_info",
      "expect_nested": {
        "run.stage": 1,
        "run.puzzle_index": 1
      }
    },
    {
      "action": "get_run_info",
      "expect": {
        "state": "PUZZLE_ACTIVE"
      }
    },
    {
      "action": "complete_puzzle",
      "params": {
        "score": 500
      },
      "expect": {
        "passed": true
      }
    },
    {
      "action": "continue_result"
    },
    {
      "action": "get_run_info",
      "expect_nested": {
        "run.stage": 1,
        "run.puzzle_index": 2
      }
    },
    {
      "action": "complete_puzzle",
      "params": {
        "score": 500
      },
      "expect": {
        "passed": true
      }
    },
    {
      "action": "continue_result"
    },
    {
      "action": "get_run_info",
      "expect": {
        "state": "SHOP"
      }
    },
    {
      "action": "continue_shop"
    },
    {
      "action": "get_run_info",
      "expect_nested": {
        "run.stage": 2,
        "run.puzzle_index": 0
      }
    },
    {
      "action": "get_run_info",
      "expect": {
        "state": "PUZZLE_ACTIVE"
      }
    },
    {
      "assert": "assert_no_targets_satisfied"
    }
  ]
}
