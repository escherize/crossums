{
  "name": "solve_4x4",
  "description": "Solve a 4x4 puzzle correctly",
  "setup": {
    "size": 4,
    "start_board": {
      "size": 4,
      "row_targets": [
        6,
        6,
        6,
        6
      ],
      "col_targets": [
        6,
        6,
        6,
        6
      ],
      "cells": [
        [
          {
            "value": 3
          },
          {
            "value": 3
          },
          {
            "value": 1
          },
          {
            "value": 1
          }
        ],
        [
          {
            "value": 1
          },
          {
            "value": 1
          },
          {
            "value": 3
          },
          {
            "value": 3
          }
        ],
        [
          {
            "value": 3
          },
          {
            "value": 1
          },
          {
            "value": 3
          },
          {
            "value": 1
          }
        ],
        [
          {
            "value": 1
          },
          {
            "value": 3
          },
          {
            "value": 1
          },
          {
            "value": 3
          }
        ]
      ]
    }
  },
  "steps": [
    {
      "comment": "Delete non-solution cells (the 1s)"
    },
    {
      "action": "delete_cell",
      "params": {
        "row": 0,
        "col": 2
      }
    },
    {
      "action": "delete_cell",
      "params": {
        "row": 0,
        "col": 3
      }
    },
    {
      "action": "delete_cell",
      "params": {
        "row": 1,
        "col": 0
      }
    },
    {
      "action": "delete_cell",
      "params": {
        "row": 1,
        "col": 1
      }
    },
    {
      "action": "delete_cell",
      "params": {
        "row": 2,
        "col": 1
      }
    },
    {
      "action": "delete_cell",
      "params": {
        "row": 2,
        "col": 3
      }
    },
    {
      "action": "delete_cell",
      "params": {
        "row": 3,
        "col": 0
      }
    },
    {
      "action": "delete_cell",
      "params": {
        "row": 3,
        "col": 2
      }
    },
    {
      "comment": "All rows should sum to 6"
    },
    {
      "assert": "assert_row_sum",
      "params": {
        "row": 0,
        "expected": 6
      }
    },
    {
      "assert": "assert_row_sum",
      "params": {
        "row": 1,
        "expected": 6
      }
    },
    {
      "assert": "assert_row_sum",
      "params": {
        "row": 2,
        "expected": 6
      }
    },
    {
      "assert": "assert_row_sum",
      "params": {
        "row": 3,
        "expected": 6
      }
    },
    {
      "comment": "All cols should sum to 6"
    },
    {
      "assert": "assert_col_sum",
      "params": {
        "col": 0,
        "expected": 6
      }
    },
    {
      "assert": "assert_col_sum",
      "params": {
        "col": 1,
        "expected": 6
      }
    },
    {
      "assert": "assert_col_sum",
      "params": {
        "col": 2,
        "expected": 6
      }
    },
    {
      "assert": "assert_col_sum",
      "params": {
        "col": 3,
        "expected": 6
      }
    },
    {
      "assert": "assert_valid"
    }
  ]
}
