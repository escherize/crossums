{
  "name": "batch_undo_garbage_collector",
  "description": "Garbage Collector auto-deletes + triggering circle undo together",
  "setup": {
    "start_board": {
      "size": 3,
      "seed": 400,
      "row_targets": [5, 9, 9],
      "col_targets": [9, 9, 5],
      "cells": [
        [{"value": 2}, {"value": 3}, {"value": 9}],
        [{"value": 3}, {"value": 3}, {"value": 3}],
        [{"value": 9}, {"value": 3}, {"value": 2}]
      ]
    }
  },
  "steps": [
    {"action": "clear_operators"},
    {"action": "add_operator", "params": {"id": "garbage_collector"}},
    {"comment": "Circle (0,0) - no trigger yet"},
    {"action": "circle_cell", "params": {"row": 0, "col": 0}},
    {"action": "wait_idle"},
    {"assert": "assert_cell_state", "params": {"row": 0, "col": 0, "state": "circled"}},
    {"comment": "Circle (0,1) - triggers Garbage Collector: circled sum=5=target, auto-deletes (0,2)"},
    {"action": "circle_cell", "params": {"row": 0, "col": 1}},
    {"action": "wait_idle"},
    {"action": "wait_idle"},
    {"assert": "assert_cell_state", "params": {"row": 0, "col": 1, "state": "circled"}},
    {"assert": "assert_cell_state", "params": {"row": 0, "col": 2, "state": "deleted"}},
    {"comment": "Undo reverts circle (0,1) AND the auto-delete it triggered"},
    {"action": "undo"},
    {"assert": "assert_cell_state", "params": {"row": 0, "col": 1, "state": "active"}},
    {"assert": "assert_cell_state", "params": {"row": 0, "col": 2, "state": "active"}},
    {"assert": "assert_cell_state", "params": {"row": 0, "col": 0, "state": "circled"}, "_comment": "First circle still there"},
    {"comment": "Undo again reverts the first circle"},
    {"action": "undo"},
    {"assert": "assert_cell_state", "params": {"row": 0, "col": 0, "state": "active"}},
    {"action": "clear_operators"}
  ]
}
