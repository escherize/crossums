{
  "name": "operator_max_slots",
  "description": "Test that operator slots are limited to 5",
  "setup": {
    "size": 3,
    "start_board": {
      "size": 3,
      "seed": 12345,
      "row_targets": [
        7,
        5,
        5
      ],
      "col_targets": [
        5,
        4,
        8
      ],
      "cells": [
        [
          {
            "value": 1
          },
          {
            "value": 2
          },
          {
            "value": 5
          }
        ],
        [
          {
            "value": 4
          },
          {
            "value": 2
          },
          {
            "value": 3
          }
        ],
        [
          {
            "value": 5
          },
          {
            "value": 6
          },
          {
            "value": 6
          }
        ]
      ]
    }
  },
  "steps": [
    {
      "action": "clear_operators"
    },
    {
      "action": "add_operator",
      "params": {
        "id": "counter"
      }
    },
    {
      "action": "add_operator",
      "params": {
        "id": "row_master"
      }
    },
    {
      "action": "add_operator",
      "params": {
        "id": "column_master"
      }
    },
    {
      "action": "add_operator",
      "params": {
        "id": "circlicious"
      }
    },
    {
      "action": "add_operator",
      "params": {
        "id": "purist"
      }
    },
    {
      "action": "list_operators",
      "expect": {
        "count": 5
      }
    },
    {
      "action": "add_operator",
      "params": {
        "id": "counter"
      },
      "expect_error": "slots_full"
    },
    {
      "action": "list_operators",
      "expect": {
        "count": 5
      }
    },
    {
      "action": "clear_operators"
    }
  ]
}
