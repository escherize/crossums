{
  "name": "op_circlicious",
  "description": "Circlicious gives +$2 per circled, -$1 per deleted",
  "setup": {
    "start_board": {
      "size": 3,
      "seed": 103,
      "row_targets": [1, 1, 1],
      "col_targets": [1, 1, 1],
      "cells": [
        [{"value": 1}, {"value": 5}, {"value": 5}],
        [{"value": 5}, {"value": 1}, {"value": 5}],
        [{"value": 5}, {"value": 5}, {"value": 1}]
      ]
    }
  },
  "steps": [
    {"action": "clear_operators"},
    {"action": "add_operator", "params": {"id": "circlicious"}},
    {"action": "circle_cell", "params": {"row": 0, "col": 0}},
    {"action": "circle_cell", "params": {"row": 1, "col": 1}},
    {"action": "circle_cell", "params": {"row": 2, "col": 2}},
    {"action": "delete_cell", "params": {"row": 0, "col": 1}},
    {"action": "delete_cell", "params": {"row": 0, "col": 2}},
    {"action": "delete_cell", "params": {"row": 1, "col": 0}},
    {"action": "delete_cell", "params": {"row": 1, "col": 2}},
    {"action": "delete_cell", "params": {"row": 2, "col": 0}},
    {"action": "delete_cell", "params": {"row": 2, "col": 1}},
    {"action": "get_score", "params": {"time_mult": 1, "restore_count": 0},
     "expect": {"money_bonus": 0}},
    {"action": "clear_operators"}
  ]
}
