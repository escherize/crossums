{
  "name": "batch_undo_circle_then_undo",
  "description": "Manual circles are tracked in undo history",
  "setup": {"size": 3, "seed": 12345},
  "steps": [
    {"action": "clear_operators"},
    {"action": "circle_cell", "params": {"row": 0, "col": 0}},
    {"action": "circle_cell", "params": {"row": 1, "col": 1}},
    {"assert": "assert_cell_state", "params": {"row": 0, "col": 0, "state": "circled"}},
    {"assert": "assert_cell_state", "params": {"row": 1, "col": 1, "state": "circled"}},
    {"comment": "Undo last circle"},
    {"action": "undo"},
    {"assert": "assert_cell_state", "params": {"row": 1, "col": 1, "state": "active"}},
    {"assert": "assert_cell_state", "params": {"row": 0, "col": 0, "state": "circled"}},
    {"comment": "Undo first circle"},
    {"action": "undo"},
    {"assert": "assert_cell_state", "params": {"row": 0, "col": 0, "state": "active"}}
  ]
}
