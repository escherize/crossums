{
  "name": "op_click_clique",
  "description": "Click Clique auto-circles active cells when row/col sum matches target",
  "setup": {
    "start_board": {
      "size": 3,
      "seed": 300,
      "row_targets": [5, 9, 9],
      "col_targets": [9, 9, 5],
      "cells": [
        [{"value": 2}, {"value": 3}, {"value": 9}],
        [{"value": 3}, {"value": 3}, {"value": 3}],
        [{"value": 9}, {"value": 3}, {"value": 2}]
      ]
    }
  },
  "steps": [
    {"action": "clear_operators"},
    {"action": "add_operator", "params": {"id": "click_clique"}},
    {"comment": "Row 0 target is 5. Delete cell (0,2) value 9. Remaining: 2+3=5 matches target."},
    {"comment": "Click Clique should auto-circle cells (0,0) and (0,1)."},
    {"action": "delete_cell", "params": {"row": 0, "col": 2}},
    {"action": "wait_idle"},
    {"action": "wait_idle"},
    {"assert": "assert_cell_state", "params": {"row": 0, "col": 0, "state": "circled"}},
    {"assert": "assert_cell_state", "params": {"row": 0, "col": 1, "state": "circled"}}
  ]
}
