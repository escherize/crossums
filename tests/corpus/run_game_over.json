{
  "name": "run_game_over",
  "description": "Test missing score target triggers instant game over",
  "setup": {
    "action": "start_run"
  },
  "steps": [
    {"action": "get_run_info", "expect_nested": {"run.lives": 5}},
    {"action": "get_run_info", "expect": {"state": "PUZZLE_ACTIVE"}},

    {"action": "complete_puzzle", "params": {"score": 0}, "expect": {"passed": false}},
    {"action": "get_run_info", "expect": {"state": "GAME_OVER"}}
  ]
}
