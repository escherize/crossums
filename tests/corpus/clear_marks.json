{
  "name": "clear_marks",
  "description": "Test that clear_all_marks resets the grid",
  "setup": {
    "size": 3,
    "start_board": {
      "size": 3,
      "seed": 12345,
      "row_targets": [
        7,
        5,
        5
      ],
      "col_targets": [
        5,
        4,
        8
      ],
      "cells": [
        [
          {
            "value": 1
          },
          {
            "value": 2
          },
          {
            "value": 5
          }
        ],
        [
          {
            "value": 4
          },
          {
            "value": 2
          },
          {
            "value": 3
          }
        ],
        [
          {
            "value": 5
          },
          {
            "value": 6
          },
          {
            "value": 6
          }
        ]
      ]
    }
  },
  "steps": [
    {
      "action": "delete_cell",
      "params": {
        "row": 0,
        "col": 0
      }
    },
    {
      "action": "delete_cell",
      "params": {
        "row": 2,
        "col": 1
      }
    },
    {
      "assert": "assert_cell_state",
      "params": {
        "row": 0,
        "col": 0,
        "state": "deleted"
      }
    },
    {
      "assert": "assert_cell_state",
      "params": {
        "row": 2,
        "col": 1,
        "state": "deleted"
      }
    },
    {
      "action": "clear_all_marks"
    },
    {
      "assert": "assert_cell_state",
      "params": {
        "row": 0,
        "col": 0,
        "state": "active"
      }
    },
    {
      "assert": "assert_cell_state",
      "params": {
        "row": 2,
        "col": 1,
        "state": "active"
      }
    }
  ]
}
