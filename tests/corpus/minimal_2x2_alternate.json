{
  "name": "minimal_2x2_alternate",
  "description": "2x2 edge case with two valid solutions",
  "setup": {
    "size": 2,
    "start_board": {
      "size": 2,
      "row_targets": [
        1,
        1
      ],
      "col_targets": [
        1,
        1
      ],
      "cells": [
        [
          {
            "value": 1
          },
          {
            "value": 1
          }
        ],
        [
          {
            "value": 1
          },
          {
            "value": 1
          }
        ]
      ]
    }
  },
  "steps": [
    {
      "comment": "2x2 all 1s with diagonal as solution - anti-diagonal also works"
    },
    {
      "comment": "Delete (0,0) which is marked as solution - should be allowed"
    },
    {
      "action": "delete_cell",
      "params": {
        "row": 0,
        "col": 0
      },
      "expect_nested": {
        "cell.was_mistake": false,
        "cell.state": "deleted"
      }
    },
    {
      "comment": "Now (0,1) is critical for row 0"
    },
    {
      "action": "delete_cell",
      "params": {
        "row": 0,
        "col": 1
      },
      "expect_nested": {
        "cell.was_mistake": true,
        "cell.state": "active"
      }
    },
    {
      "comment": "(1,0) is now critical for col 0"
    },
    {
      "action": "delete_cell",
      "params": {
        "row": 1,
        "col": 0
      },
      "expect_nested": {
        "cell.was_mistake": true,
        "cell.state": "active"
      }
    },
    {
      "comment": "But (1,1) can be deleted - alternate solution uses anti-diagonal"
    },
    {
      "action": "delete_cell",
      "params": {
        "row": 1,
        "col": 1
      },
      "expect_nested": {
        "cell.was_mistake": false,
        "cell.state": "deleted"
      }
    },
    {
      "assert": "assert_valid"
    }
  ]
}
