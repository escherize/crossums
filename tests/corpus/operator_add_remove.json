{
  "name": "operator_add_remove",
  "description": "Test adding and removing operators via debug server",
  "setup": {
    "size": 3,
    "start_board": {
      "size": 3,
      "seed": 12345,
      "row_targets": [
        7,
        5,
        5
      ],
      "col_targets": [
        5,
        4,
        8
      ],
      "cells": [
        [
          {
            "value": 7,
            "is_solution": false
          },
          {
            "value": 5,
            "is_solution": true
          },
          {
            "value": 1,
            "is_solution": false
          }
        ],
        [
          {
            "value": 8,
            "is_solution": true
          },
          {
            "value": 2,
            "is_solution": false
          },
          {
            "value": 9,
            "is_solution": true
          }
        ],
        [
          {
            "value": 5,
            "is_solution": true
          },
          {
            "value": 1,
            "is_solution": true
          },
          {
            "value": 8,
            "is_solution": false
          }
        ]
      ]
    }
  },
  "steps": [
    {
      "action": "clear_operators"
    },
    {
      "action": "list_operators",
      "expect": {
        "count": 0
      }
    },
    {
      "action": "add_operator",
      "params": {
        "id": "counter"
      }
    },
    {
      "action": "list_operators",
      "expect": {
        "count": 1
      }
    },
    {
      "action": "add_operator",
      "params": {
        "id": "lucky_seven"
      }
    },
    {
      "action": "list_operators",
      "expect": {
        "count": 2
      }
    },
    {
      "action": "remove_operator",
      "params": {
        "index": 0
      }
    },
    {
      "action": "list_operators",
      "expect": {
        "count": 1
      }
    },
    {
      "action": "clear_operators"
    },
    {
      "action": "list_operators",
      "expect": {
        "count": 0
      }
    }
  ]
}
