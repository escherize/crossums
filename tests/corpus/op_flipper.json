{
  "name": "op_flipper",
  "description": "Flipper gives +40 per 6 or 9 kept",
  "setup": {
    "start_board": {
      "size": 3,
      "seed": 102,
      "row_targets": [15, 15, 15],
      "col_targets": [15, 15, 15],
      "cells": [
        [{"value": 6}, {"value": 9}, {"value": 1}],
        [{"value": 9}, {"value": 6}, {"value": 1}],
        [{"value": 1}, {"value": 1}, {"value": 13}]
      ]
    }
  },
  "steps": [
    {"action": "clear_operators"},
    {"action": "add_operator", "params": {"id": "flipper"}},
    {"action": "apply_solution"},
    {"action": "get_score", "params": {"time_mult": 1, "restore_count": 0},
     "expect": {"operator_bonus": 160}},
    {"action": "clear_operators"}
  ]
}
