{
  "name": "circle_solved_then_uncircle",
  "description": "Uncircling a cell removes circle_solved status from row/col",
  "setup": {
    "size": 3,
    "start_board": {
      "size": 3,
      "row_targets": [7, 5, 5],
      "col_targets": [5, 4, 8],
      "cells": [
        [{"value": 1}, {"value": 2}, {"value": 5}],
        [{"value": 4}, {"value": 2}, {"value": 3}],
        [{"value": 5}, {"value": 6}, {"value": 6}]
      ]
    }
  },
  "steps": [
    {"comment": "Circle both solution cells for row 0: (0,1) and (0,2)"},
    {
      "action": "circle_cell",
      "params": {"row": 0, "col": 1}
    },
    {
      "action": "circle_cell",
      "params": {"row": 0, "col": 2}
    },
    {"comment": "Row 0 should now be circle-solved"},
    {
      "action": "get_row_sum",
      "params": {"row": 0},
      "expect": {"circle_solved": true}
    },
    {"comment": "Uncircle one cell - no longer circle-solved"},
    {
      "action": "uncircle_cell",
      "params": {"row": 0, "col": 1}
    },
    {
      "action": "get_row_sum",
      "params": {"row": 0},
      "expect": {"circle_solved": false}
    },
    {"comment": "Re-circle the cell - should be circle-solved again"},
    {
      "action": "circle_cell",
      "params": {"row": 0, "col": 1}
    },
    {
      "action": "get_row_sum",
      "params": {"row": 0},
      "expect": {"circle_solved": true}
    }
  ]
}
