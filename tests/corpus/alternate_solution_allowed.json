{
  "name": "alternate_solution_allowed",
  "description": "Deleting a 'solution' cell should be allowed when alternate solutions exist",
  "setup": {
    "size": 4,
    "start_board": {
      "size": 4,
      "row_targets": [
        1,
        1,
        1,
        1
      ],
      "col_targets": [
        1,
        1,
        1,
        1
      ],
      "cells": [
        [
          {
            "value": 1
          },
          {
            "value": 1
          },
          {
            "value": 1
          },
          {
            "value": 1
          }
        ],
        [
          {
            "value": 1
          },
          {
            "value": 1
          },
          {
            "value": 1
          },
          {
            "value": 1
          }
        ],
        [
          {
            "value": 1
          },
          {
            "value": 1
          },
          {
            "value": 1
          },
          {
            "value": 1
          }
        ],
        [
          {
            "value": 1
          },
          {
            "value": 1
          },
          {
            "value": 1
          },
          {
            "value": 1
          }
        ]
      ]
    }
  },
  "steps": [
    {
      "comment": "Grid is all 1s. The intended solution is the diagonal, but any permutation works."
    },
    {
      "comment": "Delete (0,0) which IS marked as solution - should be allowed since alternates exist"
    },
    {
      "action": "delete_cell",
      "params": {
        "row": 0,
        "col": 0
      },
      "expect_nested": {
        "cell.was_mistake": false,
        "cell.state": "deleted"
      }
    },
    {
      "comment": "Now complete an alternate solution: (0,1), (1,0), (2,3), (3,2)"
    },
    {
      "action": "delete_cell",
      "params": {
        "row": 0,
        "col": 2
      }
    },
    {
      "action": "delete_cell",
      "params": {
        "row": 0,
        "col": 3
      }
    },
    {
      "action": "delete_cell",
      "params": {
        "row": 1,
        "col": 1
      }
    },
    {
      "action": "delete_cell",
      "params": {
        "row": 1,
        "col": 2
      }
    },
    {
      "action": "delete_cell",
      "params": {
        "row": 1,
        "col": 3
      }
    },
    {
      "action": "delete_cell",
      "params": {
        "row": 2,
        "col": 0
      }
    },
    {
      "action": "delete_cell",
      "params": {
        "row": 2,
        "col": 1
      }
    },
    {
      "action": "delete_cell",
      "params": {
        "row": 2,
        "col": 2
      }
    },
    {
      "action": "delete_cell",
      "params": {
        "row": 3,
        "col": 0
      }
    },
    {
      "action": "delete_cell",
      "params": {
        "row": 3,
        "col": 1
      }
    },
    {
      "action": "delete_cell",
      "params": {
        "row": 3,
        "col": 3
      }
    },
    {
      "assert": "assert_valid"
    }
  ]
}
