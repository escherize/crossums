{
  "name": "solution_cell_protected",
  "description": "Clicking a solution cell doesn't delete it - returns was_mistake and keeps cell active",
  "setup": {
    "size": 3,
    "start_board": {
      "size": 3,
      "seed": 12345,
      "row_targets": [
        7,
        5,
        5
      ],
      "col_targets": [
        5,
        4,
        8
      ],
      "cells": [
        [
          {
            "value": 1
          },
          {
            "value": 2
          },
          {
            "value": 5
          }
        ],
        [
          {
            "value": 4
          },
          {
            "value": 2
          },
          {
            "value": 3
          }
        ],
        [
          {
            "value": 5
          },
          {
            "value": 6
          },
          {
            "value": 6
          }
        ]
      ]
    }
  },
  "steps": [
    {
      "action": "delete_cell",
      "params": {
        "row": 0,
        "col": 1
      },
      "expect_nested": {
        "cell.was_mistake": true,
        "cell.state": "active"
      }
    },
    {
      "assert": "assert_cell_state",
      "params": {
        "row": 0,
        "col": 1,
        "state": "active"
      }
    }
  ]
}
