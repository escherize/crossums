{
  "name": "batch_undo_gc_multiple_cells",
  "description": "Garbage Collector + triggering circle undo together",
  "setup": {
    "start_board": {
      "size": 4,
      "seed": 500,
      "row_targets": [6, 50, 50, 50],
      "col_targets": [50, 50, 50, 50],
      "cells": [
        [{"value": 1}, {"value": 2}, {"value": 3}, {"value": 5}],
        [{"value": 2}, {"value": 3}, {"value": 4}, {"value": 1}],
        [{"value": 3}, {"value": 4}, {"value": 1}, {"value": 2}],
        [{"value": 4}, {"value": 1}, {"value": 2}, {"value": 3}]
      ]
    }
  },
  "steps": [
    {"action": "clear_operators"},
    {"action": "add_operator", "params": {"id": "garbage_collector"}},
    {"comment": "Circle first two - no trigger yet"},
    {"action": "circle_cell", "params": {"row": 0, "col": 0}},
    {"action": "circle_cell", "params": {"row": 0, "col": 1}},
    {"action": "wait_idle"},
    {"comment": "Circle third - triggers GC: 1+2+3=6=target, auto-deletes (0,3)"},
    {"action": "circle_cell", "params": {"row": 0, "col": 2}},
    {"action": "wait_idle"},
    {"action": "wait_idle"},
    {"assert": "assert_cell_state", "params": {"row": 0, "col": 3, "state": "deleted"}},
    {"comment": "Undo reverts circle (0,2) AND the auto-delete"},
    {"action": "undo"},
    {"assert": "assert_cell_state", "params": {"row": 0, "col": 2, "state": "active"}},
    {"assert": "assert_cell_state", "params": {"row": 0, "col": 3, "state": "active"}},
    {"comment": "First two circles still there"},
    {"assert": "assert_cell_state", "params": {"row": 0, "col": 0, "state": "circled"}},
    {"assert": "assert_cell_state", "params": {"row": 0, "col": 1, "state": "circled"}},
    {"action": "clear_operators"}
  ]
}
