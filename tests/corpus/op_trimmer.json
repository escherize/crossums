{
  "name": "op_trimmer",
  "description": "Trimmer auto-deletes cells that exceed their row or column target",
  "setup": {
    "start_board": {
      "size": 3,
      "seed": 500,
      "row_targets": [3, 6, 4],
      "col_targets": [5, 4, 4],
      "cells": [
        [{"value": 1}, {"value": 2}, {"value": 5}],
        [{"value": 3}, {"value": 2}, {"value": 1}],
        [{"value": 1}, {"value": 7}, {"value": 2}]
      ]
    }
  },
  "steps": [
    {"action": "clear_operators"},
    {"action": "add_operator", "params": {"id": "trimmer"}},
    {"comment": "Trigger auto-actions now that operator is added"},
    {"action": "check_auto_actions"},
    {"action": "wait_idle"},
    {"comment": "Cell (0,2) = 5 > row_target[0]=3, should be auto-deleted"},
    {"comment": "Cell (2,1) = 7 > row_target[2]=4 and > col_target[1]=4, should be auto-deleted"},
    {"assert": "assert_cell_state", "params": {"row": 0, "col": 2, "state": "deleted"}},
    {"assert": "assert_cell_state", "params": {"row": 2, "col": 1, "state": "deleted"}},
    {"comment": "Cells that don't exceed targets should remain active"},
    {"assert": "assert_cell_state", "params": {"row": 0, "col": 0, "state": "active"}},
    {"assert": "assert_cell_state", "params": {"row": 1, "col": 1, "state": "active"}}
  ]
}
