{
  "name": "batch_undo_click_clique",
  "description": "Click Clique auto-circles are batched - one undo reverts all circles",
  "setup": {
    "start_board": {
      "size": 3,
      "seed": 300,
      "row_targets": [5, 9, 9],
      "col_targets": [9, 9, 5],
      "cells": [
        [{"value": 2}, {"value": 3}, {"value": 9}],
        [{"value": 3}, {"value": 3}, {"value": 3}],
        [{"value": 9}, {"value": 3}, {"value": 2}]
      ]
    }
  },
  "steps": [
    {"action": "clear_operators"},
    {"action": "add_operator", "params": {"id": "click_clique"}},
    {"comment": "Row 0 target is 5. Delete cell (0,2)=9. Remaining: 2+3=5 matches target."},
    {"comment": "Click Clique should auto-circle (0,0) and (0,1)."},
    {"action": "delete_cell", "params": {"row": 0, "col": 2}},
    {"action": "wait_idle"},
    {"action": "wait_idle"},
    {"assert": "assert_cell_state", "params": {"row": 0, "col": 0, "state": "circled"}},
    {"assert": "assert_cell_state", "params": {"row": 0, "col": 1, "state": "circled"}},
    {"comment": "Undo once - should revert both auto-circles"},
    {"action": "undo"},
    {"assert": "assert_cell_state", "params": {"row": 0, "col": 0, "state": "active"}},
    {"assert": "assert_cell_state", "params": {"row": 0, "col": 1, "state": "active"}},
    {"comment": "The manual delete should still be undone"},
    {"assert": "assert_cell_state", "params": {"row": 0, "col": 2, "state": "deleted"}},
    {"comment": "Undo again - now the manual delete is reverted"},
    {"action": "undo"},
    {"assert": "assert_cell_state", "params": {"row": 0, "col": 2, "state": "active"}},
    {"action": "clear_operators"}
  ]
}
