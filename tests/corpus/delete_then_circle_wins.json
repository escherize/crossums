{
  "name": "delete_then_circle_wins",
  "description": "Delete cells first, then circle remaining - should auto-win when sums match",
  "setup": {
    "size": 3,
    "start_board": {
      "size": 3,
      "row_targets": [7, 5, 5],
      "col_targets": [5, 4, 8],
      "cells": [
        [{"value": 1}, {"value": 2}, {"value": 5}],
        [{"value": 4}, {"value": 2}, {"value": 3}],
        [{"value": 5}, {"value": 6}, {"value": 6}]
      ]
    }
  },
  "steps": [
    {"comment": "Solution cells: (0,1)=2, (0,2)=5, (1,1)=2, (1,2)=3, (2,0)=5"},
    {"comment": "Delete some non-solution cells first"},
    {
      "action": "delete_cell",
      "params": {"row": 0, "col": 0}
    },
    {
      "action": "delete_cell",
      "params": {"row": 1, "col": 0}
    },
    {
      "action": "delete_cell",
      "params": {"row": 2, "col": 1}
    },
    {"comment": "Now circle some cells (doesn't change sum, just marks them)"},
    {
      "action": "circle_cell",
      "params": {"row": 0, "col": 2}
    },
    {
      "action": "circle_cell",
      "params": {"row": 1, "col": 2}
    },
    {"comment": "Delete the last non-solution cell - this should trigger win"},
    {
      "action": "delete_cell",
      "params": {"row": 2, "col": 2}
    },
    {"comment": "Puzzle should auto-win - mix of circled and active cells match targets"},
    {
      "assert": "assert_puzzle_complete"
    }
  ]
}
